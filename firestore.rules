rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // HANYA DEMO: siapa pun yang membuka aplikasi dapat memperoleh identitas anonim
    // dan membaca/mengubah seluruh data pada peternakan demo. TIDAK AMAN UNTUK PRODUKSI.
    match /farms/demo-peternakan {
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
